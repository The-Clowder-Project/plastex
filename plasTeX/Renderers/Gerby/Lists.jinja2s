name: itemize
<ul>
  {{ obj }}
</ul>

name: enumerate
<ol class="main-list">
  {{ obj }}
</ol>

name: description
<dl>
{% for item in obj %}
  <dt>{{ item.attributes.term or obj.attributes.defaultlabel }}</dt>
  <dd>{{ item }}</dd>
{% endfor %}
</dl>

name: item
<li
  {%- if obj.ref %}
    class="enumerate-item" {# For enumerated lists with a counter #}
  {%- else %}
    class="itemize-item" {# For itemize or other lists without a .ref #}
  {%- endif %}
  {%- if obj.userdata['tag'] %}
    id="{{- obj.userdata['tag'] -}}"
  {% endif -%} {# Gerby tag for linking #}
>
<span class="counter">
  {# The link target uses the Gerby tag if available, otherwise the item's own DOM id as a fallback #}
  {%- if obj.parentNode.nodeName == "itemize" -%}
    <span class="counter-link" href="/tag/{{- obj.userdata['tag'] if obj.userdata['tag'] else obj.id -}}"><span class="counter-inner-no-tag">•</span></span>
  {%- else %}
    <a class="counter-link" href="/tag/{{- obj.userdata['tag'] if obj.userdata['tag'] else obj.id -}}">
      <span
        {%- if obj.ref %} class="counter-inner"        {# For enumerated lists with a counter #}
        {%- else %}       class="counter-inner-no-tag" {# For itemize or other lists without a .ref #}
        {%- endif %}
      >
        {%- if obj.ref_part -%}
          {%- if obj.counter == 'enumi' -%}
            <span data-tag="{{ obj.userdata['tag'] }}">{{- obj.ref -}}.</span>
          {%- else -%}
            <span data-tag="{{ obj.userdata['tag'] }}">({{- obj.ref_part -}})</span>
          {%- endif -%}
        {%- endif -%}
      </span>
    </a>
  {%- endif -%}
</span>
{# The actual content of the list item, wrapped for potential styling #}
<span class="item-content">{{- obj -}}</span>
</li>
