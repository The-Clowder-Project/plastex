name: footnote
{#- Render the inline mark using the locally assigned number or compressed mark -#}
{#- The footnote node's own ID is used for the target of the link -#}
{%- if not obj.userdata.get('suppress_inline_mark', False) -%}
<span class="footnote" id="fnmark-{{ obj.id }}"><sup>{{- obj.userdata.get('compressed_mark_text') or obj.userdata.local_number -}}</sup></span>{%- endif -%}
{#- <a class="footnote" href="#fn-{{ obj.id }}" id="fnmark-{{ obj.id }}" content-data="{{ obj.textContent | e }}"><sup>{{- obj.userdata.get('compressed_mark_text') or obj.userdata.local_number -}}</sup></a>{%- endif -%} -#}
