name: tableofcontents input @vobeyspaces @noligs def protect let \
      newcommand hfill hline openout renewcommand write hspace appendix \
      global noindent include markboth setcounter refstepcounter \
      bigskip medskip smallskip setlength settowidth addtolength \
      nopagebreak newwrite newcounter typeout sloppypar thispagestyle vfill \
      hypertarget newenvironment reversemarginpar phantomsection \
      vskip pagestyle centerline hyperref marginnote normalmarginpar \
      bibliography bibliographystyle

name: indent
<span style="display: inline-block; margin-left: 1em"></span>

name: texorpdfstring
{{ obj.argSources['tex'][1:-1] }}

name: href
<a href="{{ obj.argSources['url'][1:-1] }}">{{ obj }}</a>

name: scalemath
<div class="equation"><div class="scalemath"><img src="/static/scalemath-images/scalemath-{{ obj }}.svg"></div></div>

name: webcompile
<div class="equation"><div class="webcompile"><img src="/static/webcompile-images/webcompile-{{ obj }}.svg"></div></div>

name: tikzcdid
<div class="equation"><div class="tikz-cd"><img src="/static/tikzcd-images/tikzcd-{{ obj }}.svg"></div></div>

name: Gape

name: envsmallsize
<div class="smallsize">{{ obj }}</div>

name: envfootnotesize
<div class="footnotesize">{{ obj }}</div>

name: envscriptsize
<div class="scriptsize">{{ obj }}</div>

name: envtinysize
<div class="tinysize">{{ obj }}</div>

name: itemstar
<li class="itemize-item"><span class="counter"><span class="counter-inner-no-tag">(★)</span><span class="item-content">{{- obj -}}</span></li>

name: textdbend
<span class="textdbend-container"><span class="textdbend-content"><img alt="Dangerous Bend Symbol" class="textdbend-image" src="/static/images/dbend.svg">

name: bgroup
{{- obj -}}

name: egroup

name: envwebgif
<div class="webgif">{{ obj }}</div>

name: webgif
<img src="/static/gifs/{{ obj }}" class="webgifimg">

name: audio
<audio controls><source src="/static/audios/{{ obj }}" type="audio/mpeg"></audio> 

name: warningsign
<img src="/static/images/warning.svg" width="20px" style="margin-top:-5px">

name: doubleepigraph
<div class="epigraph-container">
  <div class="epigraph">
    <p>{{ obj.attributes.epigraph_one }}</p>
    <div class="line"></div>
    <p class="author-left">{{ obj.attributes.author_one }}</p>
  </div>
  <div class="epigraph">
    <p>{{ obj.attributes.epigraph_two }}</p>
    <div class="line"></div>
    <p class="author-right">{{ obj.attributes.author_two }}</p>
  </div>
</div>

name: IPA
<span class="brill">{{ obj }}</span>

name: includegraphics
<div class="figure"><img style="width:100%;" src="{{ obj.final_src }}"></div>

name: xspace
{%- if obj.nextSibling[0] in ['.', ',', ';', ':', '?', '!', ')', ']', '}'] -%}
{%- else -%}
<span class="whitespace-span"> </span>
{%- endif -%}

name: textiff
{%- if obj.nextSibling[0] in ['.', ',', ';', ':', '?', '!', ')', ']', '}'] -%}
iff
{%- else -%}
iff<span class="whitespace-span"> </span>
{%- endif -%}

name: vs
{%- if obj.nextSibling[0] in ['.', ',', ';', ':', '?', '!', ')', ']', '}'] -%}
vs.
{%- else -%}
vs.<span class="whitespace-span"> </span>
{%- endif -%}
