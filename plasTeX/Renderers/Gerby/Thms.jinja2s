name: thmenv
{# Eagerly compute local_footnotes to ensure numbers are set on footnote objects before their marks are rendered #}
{% set _ = obj.local_footnotes %}
{# Preprocess footnotes within this theorem for potential mark compression #}
{% set _ = obj.preprocess_footnotes_for_compression() %}
{%- if obj.thmName == "warning" -%}
<img src="/static/images/dbend.svg" class="warning-test">
<div class="gogogo-text gogogo-start-1">ゴ</div>
<div class="gogogo-text gogogo-start-2">ゴ</div>
<div class="gogogo-text gogogo-start-3">ゴ</div>
{%- endif -%}
<div class="env-{{ obj.thmName }}-header"><a class="environment-identifier" href="/tag/{{ obj.userdata['tag'] }}">{{ obj.caption }} <span data-tag="{{ obj.userdata['tag'] }}">{{ obj.ref }}</span><span class="triangleright"> ▶ </span><span class="named">{{ obj.title }}</span></a></div>
<article class="env-{{ obj.thmName }}" id="{{ obj.userdata['tag'] }}">
  {# --- Renders the heading --- #}
  {% set states = {'printIdentifier': False} %}
  {% for par in obj %}
    {% if par.isItWhitespace %}
      {{ par }}
    {% else %}
  <p>
    {{ par }}</p> {# Render the paragraph content #}
    {% endif %}
  {% endfor %}

  {# --- SECTION FOR LOCAL FOOTNOTES LIST AT THE END OF THE ENVIRONMENT --- #}
  {% set notes = obj.local_footnotes %} {# This will use the cached version #}
  {% if notes %}
  <div class="local-footnotes">
    <hr /> {# Optional separator #}
    <ol class="footnotes">
    {%- for note in notes -%}
      {#- Use the footnote's own ID as the list item's ID for linking -#}
      <li id="fn-{{ note.id }}">
         <sup>{{- note.userdata.local_number -}}</sup> {#- Display local number for the footnote in the list -#}
         {{- note -}} {#- Render the actual footnote content -#}
      </li>
    {% endfor %}
    </ol>
  </div>
  {% endif %}
</article> {# End of the thmenv article #}
<div class="env-{{ obj.thmName }}-footer"></div>
{%- if obj.thmName == "warning" -%}
<div class="gogogo-text gogogo-end-1">ゴ</div>
<div class="gogogo-text gogogo-end-2">ゴ</div>
<div class="gogogo-text gogogo-end-3">ゴ</div>
{%- endif -%}

name: proof
{# Eagerly compute local_footnotes to ensure numbers are set on footnote objects before their marks are rendered #}
{% set _ = obj.local_footnotes %}
{# Preprocess footnotes within this proof for potential mark compression #}
{% set _ = obj.preprocess_footnotes_for_compression() %}
<div class="env-proof-header"><strong>{{ obj.caption }}.</strong></div>
<article class="env-proof">
  {% for par in obj %}
    <p>
    {% if loop.first %}
      {% if obj.caption %}
      {% else %}
      {# Assuming 'proofname' exists in context like amsthm provides #}
      <strong>{{ context.terms.get('proof', 'Proof') }}.</strong>
      {% endif %}
    {% endif %}
      {# --- Render the paragraph content (potentially including footnote marks) --- #}
      {{ par }}
      {# --- Place QED symbol at the very end of the last paragraph --- #}
    {% if loop.last %}
      <span class="qed"><img src="/static/images/trans-flag.svg" width="15px"></span>
    {% endif %}
    </p>
  {% endfor %}

  {# --- SECTION FOR LOCAL FOOTNOTES LIST AT THE END OF THE PROOF --- #}
  {% set notes = obj.local_footnotes %} {# This will use the cached version #}
  {% if notes %}
  <div class="local-footnotes">
    <hr /> {# Optional separator #}
    <ol class="footnotes">
    {%- for note in notes -%}
      {#- Use the footnote's own ID as the list item's ID for linking -#}
      <li id="fn-{{ note.id }}">
         <sup>{{- note.userdata.local_number -}}</sup> {#- Display local number for the footnote in the list -#}
         {{- note -}} {#- Render the actual footnote content -#}
      </li>
    {% endfor %}
    </ol>
  </div>
  {% endif %}
</article> {# End of the proof article #}
<div class="env-proof-footer"></div>

name: reference slogan history
{{ obj }}

name: ProofBox
<div class="proofbox">{{ obj }}</div>

name: SubProofBox
<div class="subproofbox">{{ obj }}</div>
