name: thmenv
<div class="env-{{ obj.thmName }}-header"><a class="environment-identifier" href="/tag/{{ obj.userdata['tag'] }}">{{ obj.caption }} <span data-tag="{{ obj.userdata['tag'] }}">{{ obj.ref }}</span><span class="triangleright"> ▶ </span><span class="named">{{ obj.title }}</span></a></div>
<article class="env-{{ obj.thmName }}" id="{{ obj.userdata['tag'] }}">
  {# --- Renders the heading --- #}
  {% set states = {'printIdentifier': False} %}
  {% for par in obj %}
    {% if par.isItWhitespace %}
      {{ par }}
    {% else %}
  <p>
    {{ par }}</p> {# Render the paragraph content #}
    {% endif %}
  {% endfor %}

  {# --- ADDED SECTION FOR LOCAL FOOTNOTES --- #}
  {% set notes = obj.local_footnotes %}
  {% if notes %}
  <div class="local-footnotes">
    <hr /> {# Optional separator #}
    <ol>
    {% for note in notes %}
      {# Use the footnote's own ID as the list item's ID for linking #}
      <li id="fn-{{ note.id }}">
         <sup>{{ note.userdata.local_number }}</sup> {# Display local number #}
         {{ note }} {# Render the actual footnote content #}
      </li>
    {% endfor %}
    </ol>
  </div>
  {% endif %}
  {# --- END OF ADDED SECTION --- #}

</article> {# End of the thmenv article #}
<div class="env-{{ obj.thmName }}-footer"></div>

name: proof
<div class="env-proof-header"><strong>{{ obj.caption }}.</strong></div>
<article class="env-proof">
  {% for par in obj %}
    <p>
    {% if loop.first %}
      {% if obj.caption %}
      {% else %}
      {# Assuming 'proofname' exists in context like amsthm provides #}
      <strong>{{ context.terms.get('proof', 'Proof') }}.</strong>
      {% endif %}
    {% endif %}
      {# --- Render the paragraph content (potentially including footnote marks) --- #}
      {{ par }}
      {# --- Place QED symbol at the very end of the last paragraph --- #}
    {% if loop.last %}
      <span class="qed">$\square$</span>
    {% endif %}
    </p>
  {% endfor %}

  {# --- ADD THIS NEW SECTION FOR LOCAL FOOTNOTES --- #}
  {% set notes = obj.local_footnotes %}
  {% if notes %}
  <div class="local-footnotes">
    <hr /> {# Optional separator #}
    <ol>
    {% for note in notes %}
      {# Use the footnote's own ID as the list item's ID for linking #}
      <li id="fn-{{ note.id }}">
         <sup>{{ note.userdata.local_number }}</sup> {# Display local number #}
         {{ note }} {# Render the actual footnote content #}
      </li>
    {% endfor %}
    </ol>
  </div>
  {% endif %}
  {# --- END OF ADDED SECTION --- #}

</article> {# End of the proof article #}
<div class="env-proof-footer"></div>


name: reference slogan history
{{ obj }}
